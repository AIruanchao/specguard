{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specguard.local/schemas/ci-evidence.schema.json",
  "title": "CI Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system", "status", "stages"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "minLength": 7
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "blocked"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "stages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status", "commands"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "blocked"]
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "exit_code"],
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "exit_code": {
                  "type": "integer"
                },
                "log": {
                  "type": "string"
                }
              }
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": ["number", "integer", "string", "boolean", "null"]
            }
          }
        }
      }
    }
  }
}
